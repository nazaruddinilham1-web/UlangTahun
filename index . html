<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Happy Birthday Amira Aulia Dewi 🎂</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html,body{
    width:100%;
    height:100%;
    overflow:hidden;
    font-family:"Segoe UI",sans-serif;
}

body{
    background:#08090d;
    color:white;
}

/* BACKGROUND */
.bg{
    position:fixed;
    inset:0;
    background:
        radial-gradient(circle at 20% 20%, #6b355655, transparent 35%),
        radial-gradient(circle at 80% 70%, #9b4d6d44, transparent 35%),
        linear-gradient(135deg,#08090d,#180d16 55%,#08090d);
    z-index:-3;
}

.stars{
    position:fixed;
    inset:0;
    z-index:-2;
    overflow:hidden;
}

.star{
    position:absolute;
    width:3px;
    height:3px;
    background:white;
    border-radius:50%;
    opacity:.7;
    animation:twinkle 2s infinite alternate;
}

@keyframes twinkle{
    from{opacity:.2;transform:scale(.7)}
    to{opacity:1;transform:scale(1.3)}
}

/* SLIDE */
.slide{
    position:absolute;
    inset:0;
    display:flex;
    justify-content:center;
    align-items:center;
    padding:25px;
    opacity:0;
    pointer-events:none;
    transform:translateX(60px) scale(.97);
    transition:
        opacity .7s ease,
        transform .7s ease;
}

.slide.active{
    opacity:1;
    pointer-events:auto;
    transform:translateX(0) scale(1);
}

.card{
    width:min(92%,650px);
    max-height:90vh;
    overflow:auto;
    text-align:center;
    padding:30px 24px;
    border:1px solid #ffffff20;
    border-radius:28px;
    background:#ffffff0c;
    backdrop-filter:blur(15px);
    box-shadow:0 20px 70px #00000080;
}

/* TEXT */
.small{
    font-size:14px;
    letter-spacing:3px;
    text-transform:uppercase;
    color:#e7b5c9;
}

h1{
    font-size:clamp(38px,10vw,75px);
    margin:15px 0;
    background:linear-gradient(90deg,#fff,#f3a9c5,#fff);
    -webkit-background-clip:text;
    color:transparent;
}

h2{
    font-size:clamp(28px,7vw,48px);
    margin:12px 0;
}

p{
    line-height:1.8;
    color:#eee;
    font-size:16px;
}

/* FOTO */
.photo{
    width:min(85vw,360px);
    max-height:48vh;
    object-fit:cover;
    border-radius:25px;
    margin:18px auto;
    display:block;
    border:4px solid #ffffff25;
    box-shadow:0 15px 50px #00000090;
    animation:photoFloat 4s ease-in-out infinite;
}

@keyframes photoFloat{
    0%,100%{transform:translateY(0)}
    50%{transform:translateY(-8px)}
}

/* BUTTON */
button{
    border:0;
    padding:13px 24px;
    margin:8px;
    border-radius:999px;
    color:white;
    background:linear-gradient(135deg,#9b4166,#d8759c);
    font-size:15px;
    cursor:pointer;
    box-shadow:0 8px 25px #00000055;
    transition:.25s;
}

button:hover{
    transform:translateY(-3px);
    box-shadow:0 12px 30px #00000080;
}

/* UCAPAN */
.message{
    text-align:left;
    max-height:48vh;
    overflow:auto;
    padding:5px 8px;
}

.message p{
    margin-bottom:15px;
}

/* HEART */
.heart{
    font-size:65px;
    animation:heart 1.3s infinite;
}

@keyframes heart{
    0%,100%{transform:scale(1)}
    50%{transform:scale(1.18)}
}

/* FOTO GRID */
.gallery{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:10px;
    margin:20px 0;
}

.gallery img{
    width:100%;
    height:180px;
    object-fit:cover;
    border-radius:18px;
    border:2px solid #ffffff20;
    transition:.3s;
}

.gallery img:hover{
    transform:scale(1.03);
}

/* NAV */
.nav{
    position:fixed;
    bottom:22px;
    left:50%;
    transform:translateX(-50%);
    display:flex;
    align-items:center;
    gap:12px;
    z-index:10;
}

.dot{
    width:8px;
    height:8px;
    border-radius:50%;
    background:#ffffff45;
    transition:.3s;
}

.dot.active{
    width:25px;
    border-radius:10px;
    background:#f3a9c5;
}

.counter{
    position:fixed;
    top:20px;
    right:22px;
    font-size:13px;
    color:#ffffff88;
}

/* CONFETTI */
.confetti{
    position:fixed;
    width:8px;
    height:12px;
    top:-20px;
    animation:fall 4s linear forwards;
    z-index:20;
}

@keyframes fall{
    to{
        transform:translateY(110vh) rotate(720deg);
        opacity:0;
    }
}

/* MOBILE */
@media(max-width:600px){
    .card{
        padding:25px 18px;
    }

    p{
        font-size:15px;
    }

    .gallery img{
        height:145px;
    }

    .photo{
        max-height:42vh;
    }
}
</style>
</head>

<body>

<div class="bg"></div>
<div class="stars" id="stars"></div>

<div class="counter">
    <span id="current">1</span> / 6
</div>


<!-- SLIDE 1 -->
<section class="slide active">
    <div class="card">

        <div class="small">a little surprise for</div>

        <div class="heart">🎂</div>

        <h1>Amira</h1>

        <p>
            ada sesuatu kecil yang sengaja aku bikin<br>
            khusus buat hari ini...
        </p>

        <button onclick="nextSlide()">
            buka sekarang ✨
        </button>

    </div>
</section>


<!-- SLIDE 2 -->
<section class="slide">
    <div class="card">

        <div class="small">today is your day</div>

        <h2>Happy Birthday 🎉</h2>

        <img src="amira1.jpg" class="photo">

        <p>
            Selamat ulang tahun yaa,
            <b>Amira Aulia Dewi</b> 🤍
        </p>

        <button onclick="nextSlide()">
            lanjut →
        </button>

    </div>
</section>


<!-- SLIDE 3 -->
<section class="slide">
    <div class="card">

        <div class="small">some memories</div>

        <h2>Foto-foto Amira 📸</h2>

        <div class="gallery">
            <img src="amira1.jpg">
            <img src="amira2.jpg">
            <img src="amira3.jpg">
            <img src="amira4.jpg">
        </div>

        <button onclick="nextSlide()">
            lanjut →
        </button>

    </div>
</section>


<!-- SLIDE 4 -->
<section class="slide">
    <div class="card">

        <div class="small">a little message</div>

        <h2>Untuk kamu 🤍</h2>

        <div class="message">

            <p>
                Selamat ulang tahun yaa, Amira Aulia Dewi 🎂
            </p>

            <p>
                Nggak kerasa yaa, hari ini kamu nambah umur lagi.
                Semoga di umur yang sekarang ini kamu bisa dapetin
                banyak hal baik yang mungkin selama ini kamu harapin.
            </p>

            <p>
                Semoga hari-hari kamu ke depannya jauh lebih seru,
                lebih tenang, dan tentunya lebih banyak hal yang
                bikin kamu senyum.
            </p>

            <p>
                Jangan lupa juga buat selalu jaga diri, jaga kesehatan,
                dan jangan terlalu keras sama diri sendiri.
                Kalau ada hari yang nggak sesuai sama yang kamu mau,
                nggak apa-apa. Namanya juga hidup, kadang ada naiknya,
                kadang ada turunnya.
            </p>

            <p>
                Pokoknya semoga semua urusan kamu dimudahin,
                apa yang kamu cita-citain bisa pelan-pelan tercapai,
                dan semoga kamu selalu dikelilingi orang-orang
                yang tulus dan baik sama kamu.
            </p>

            <p>
                Terima kasih juga karena udah jadi diri kamu sendiri.
                Tetap jadi Amira yang sekarang, yang punya cerita,
                punya mimpi, dan punya perjalanan kamu sendiri.
            </p>

            <p>
                Sekali lagi, happy birthday yaa! 🥳
                Semoga tahun ini jadi salah satu tahun yang
                paling berkesan buat kamu.
            </p>

        </div>

        <button onclick="nextSlide()">
            masih ada lagi 👀
        </button>

    </div>
</section>


<!-- SLIDE 5 -->
<section class="slide">
    <div class="card">

        <div class="small">one more thing</div>

        <div class="heart">💐</div>

        <h2>Semoga...</h2>

        <p>
            semua hal baik datang ke hidup kamu
            di waktu yang tepat.
        </p>

        <p style="margin-top:15px;">
            Semoga langkah kamu selalu dipermudah,
            semoga senyum kamu tetap ada,
            dan semoga tahun ini membawa
            banyak cerita baru yang menyenangkan.
        </p>

        <button onclick="nextSlide()">
            terakhir...
        </button>

    </div>
</section>


<!-- SLIDE 6 -->
<section class="slide">
    <div class="card">

        <div class="small">that's all</div>

        <div class="heart">🎂</div>

        <h2>Happy Birthday!</h2>

        <p>
            Amira Aulia Dewi
        </p>

        <p style="margin-top:20px;">
            Semoga panjang umur,<br>
            sehat selalu,<br>
            dan semoga semua doa baik
            buat kamu satu per satu bisa terwujud. 🤍
        </p>

        <button onclick="restart()">
            lihat lagi ↻
        </button>

    </div>
</section>


<!-- NAVIGATION -->
<div class="nav">

    <button onclick="prevSlide()">←</button>

    <div id="dots"></div>

    <button onclick="nextSlide()">→</button>

</div>


<script>

const slides = document.querySelectorAll(".slide");

let current = 0;


/* BINTANG */
const stars = document.getElementById("stars");

for(let i=0;i<45;i++){

    const star = document.createElement("div");

    star.className = "star";

    star.style.left = Math.random()*100 + "%";
    star.style.top = Math.random()*100 + "%";

    star.style.animationDelay =
        Math.random()*2 + "s";

    stars.appendChild(star);
}


/* DOT */
const dots = document.getElementById("dots");

slides.forEach((_,i)=>{

    const dot = document.createElement("span");

    dot.className = "dot";

    if(i===0){
        dot.classList.add("active");
    }

    dot.onclick = ()=>{
        showSlide(i);
    };

    dots.appendChild(dot);

});


function showSlide(index){

    if(index < 0){
        index = slides.length-1;
    }

    if(index >= slides.length){
        index = 0;
    }

    slides[current].classList.remove("active");

    current = index;

    slides[current].classList.add("active");

    document.getElementById("current").textContent =
        current+1;

    document.querySelectorAll(".dot")
        .forEach((dot,i)=>{
            dot.classList.toggle(
                "active",
                i===current
            );
        });

}


function nextSlide(){

    showSlide(current+1);

    confetti();

}


function prevSlide(){

    showSlide(current-1);

}


function restart(){

    showSlide(0);

}


/* CONFETTI */
function confetti(){

    for(let i=0;i<20;i++){

        const c = document.createElement("div");

        c.className = "confetti";

        c.style.left =
            Math.random()*100 + "vw";

        c.style.background =
            ["#f3a9c5","#fff","#d8759c","#ffd166"]
            [Math.floor(Math.random()*4)];

        c.style.animationDuration =
            (2+Math.random()*3)+"s";

        document.body.appendChild(c);

        setTimeout(()=>{
            c.remove();
        },5000);

    }

}


/* SWIPE HP */
let startX = 0;

document.addEventListener("touchstart",(e)=>{
    startX = e.touches[0].clientX;
});

document.addEventListener("touchend",(e)=>{

    let endX = e.changedTouches[0].clientX;

    let distance = endX-startX;

    if(Math.abs(distance)>60){

        if(distance<0){
            nextSlide();
        }else{
            prevSlide();
        }

    }

});

</script>

</body>
	</html>
